# =============================================================================
# Clinic Analytics - variáveis de ambiente
# Copie para .env na raiz do repositório e ajuste os valores.
# NUNCA versionar o .env real.
# =============================================================================

# --- Aplicação ---
APP_NAME="Clinic Analytics API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# URL usada pelo backend e pelo pipeline (driver psycopg 3).
# No Docker Compose o host do banco é "db"; localmente, "localhost".
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5432/clinic_analytics

# --- Autenticação ---
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Senha inicial dos usuários de demonstração criados pelo seed.
DEMO_PASSWORD=Clinic@2026

# --- CORS (separe por vírgula) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Domínio / dados sintéticos ---
CLINIC_TIMEZONE=America/Fortaleza
ETL_SEED=42
# Data-âncora (AAAA-MM-DD). Vazio = usa a data atual na geração.
# Fixar a âncora garante um conjunto 100% reproduzível.
ETL_ANCHOR_DATE=
# Meses de histórico gerado para trás a partir da âncora.
ETL_HISTORY_MONTHS=18
# Dias de agenda futura gerados a partir da âncora.
ETL_FUTURE_DAYS=14

# --- Frontend (Vite) ---
# Deixe vazio para usar o proxy /api do Vite (dev) ou o proxy do Nginx (Docker).
VITE_API_BASE_URL=
# Fuso usado para exibir datas/horas (deve casar com CLINIC_TIMEZONE).
VITE_CLINIC_TIMEZONE=America/Fortaleza
